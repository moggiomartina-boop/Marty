# Copia in .env.local e compila per usare il backend condiviso (necessario per la festa).
# Senza questi valori l'app parte in MODALITÀ DEMO (solo locale, nessuna email, non sicura).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=la-tua-anon-public-key

# Facoltativo: file audio royalty-free da riprodurre al posto della musica sintetizzata.
# Metti il file in public/music/ e indica il percorso:
# VITE_MUSIC_URL=./music/christmas.mp3
